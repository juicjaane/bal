# Flask
SECRET_KEY=your-very-long-random-secret-key-here
FLASK_ENV=development
FLASK_DEBUG=1

# Firebase Admin SDK
# Option 1: JSON string (recommended for cloud deployment)
FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}
# Option 2: File path (for local development)
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# Google Earth Engine
GEE_SERVICE_ACCOUNT=your-service-account@project.iam.gserviceaccount.com
GEE_PROJECT=your-gee-project-id
# Option 1: JSON string
GEE_CREDENTIALS_JSON={"type":"service_account",...}
# Option 2: File path
GEE_CREDENTIALS_PATH=gee-credentials.json

# Email Alerts (optional — alerts logged but not emailed if not set)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=alerts@blueai.in

# Cron job API key (optional — for the /system/check-alerts endpoint)
CRON_API_KEY=your-random-secret-key
